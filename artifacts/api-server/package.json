{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --build ../../lib/db ../../lib/api-zod && tsc -p tsconfig.json --noEmit",
    "test:ssrf": "node --experimental-strip-types --test src/lib/webhook-transport.test.ts",
    "test:meta": "esbuild src/lib/meta.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/meta.test.cjs --external:pg-native --external:pino-pretty && node --test /tmp/meta.test.cjs",
    "test:meta:integration": "esbuild src/lib/meta-delivery.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/meta-delivery.integration.test.cjs --external:pg-native --external:pino-pretty && node --test /tmp/meta-delivery.integration.test.cjs",
    "test:automation": "node --experimental-strip-types --test src/lib/automation.test.ts",
    "test:automation:integration": "esbuild src/lib/automation.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/automation-integration.test.cjs --external:pg-native --external:pino-pretty && NODE_ENV=production node --test /tmp/automation-integration.test.cjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
